{
    "project": "speaker-disentanglement-grl",
    "dataset": "CREMA-D",
    "feature_extractor": "microsoft/wavlm-base-plus",
    "feature_extractor_frozen": true,
    "embedding_dimension": 768,
    "projection_dimension": 256,
    "emotion_classes": 6,
    "speaker_disjoint_split": {
        "train_speakers": 64,
        "validation_speakers": 13,
        "test_speakers": 14
    },
    "representation_training_seeds": [
        7,
        21,
        100
    ],
    "models": [
        "baseline",
        "multitask",
        "adversarial"
    ],
    "training": {
        "optimizer": "AdamW",
        "learning_rate": 0.001,
        "weight_decay": 0.0001,
        "batch_size": 32,
        "max_epochs": 30,
        "early_stopping_patience": 5,
        "grl_lambda": 1.0
    },
    "speaker_verification": {
        "attacker": "MLP",
        "attacker_initialization_seed": 42,
        "pair_features": "absolute_difference",
        "pair_matching": [
            "emotion",
            "sentence"
        ],
        "metrics": [
            "ROC-AUC",
            "EER"
        ]
    }
}